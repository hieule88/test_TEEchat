# Copy to .env and set your Edge.
# Edge base URL — MUST equal the Edge's WALLET_SERVICE_ORIGIN exactly
# (scheme + host + port), or wallet binds are refused "different service".
#
#   test Edge  : https://leviathan-edge-test.duckdns.org:8443
#   production : https://leviathan-edge.duckdns.org        (once wallet is deployed there)
VITE_EDGE_ORIGIN=https://leviathan-edge-test.duckdns.org:8443

# auth-service base URL — used only to poll intent status after an
# ON-CHAIN top-up (waitForTopup). Public read-only endpoint; the Caddy in
# front of auth-service must send Access-Control-Allow-Origin for it.
#   test  : https://leviathan-auth-test.duckdns.org:8443
#   prod  : https://leviathan-auth.duckdns.org
VITE_AUTH_ORIGIN=https://leviathan-auth-test.duckdns.org:8443
